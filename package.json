{
  "name": "lume-ssr",
  "version": "1.0.0",
  "description": "Infrastructure for the web. A minimal, standards-based JSX-to-HTML rendering primitive.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./jsx": "./src/core/jsx.js",
    "./render": "./src/core/render.js",
    "./utils": "./src/core/utils.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:examples": "npm run clean && tsx scripts/build.jsx",
    "serve:examples": "npx http-server dist -p 8080 -o",
    "dev:examples": "tsx scripts/dev-server.jsx"
  },
  "keywords": [
    "jsx",
    "ssr",
    "server-side-rendering",
    "infrastructure",
    "web-standards",
    "zero-overhead",
    "html-generation",
    "lume"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.19.0",
    "express": "^4.18.0",
    "tsx": "^4.20.6",
    "vite": "^5.0.0"
  },
  "peerDependencies": {
    "lume-js": "^0.2.1"
  },
  "peerDependenciesMeta": {
    "lume-js": {
      "optional": true
    }
  },
  "dependencies": {
    "concurrently": "^9.2.1"
  }
}