{
  "name": "lume-ssr",
  "version": "1.0.0",
  "description": "Infrastructure for the web. A minimal, standards-based JSX-to-HTML rendering primitive.",
  "type": "module",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./jsx-runtime": {
      "types": "./types/jsx-runtime.d.ts",
      "default": "./src/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./types/jsx-dev-runtime.d.ts",
      "default": "./src/jsx-dev-runtime.js"
    },
    "./jsx": "./src/core/jsx.js",
    "./render": "./src/core/render.js",
    "./utils": "./src/core/utils.js"
  },
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sathvikc/lume-ssr.git"
  },
  "scripts": {
    "test": "node --test",
    "clean": "rm -rf dist",
    "build:examples": "npm run clean && tsx scripts/build.jsx",
    "serve:examples": "npx http-server dist -p 8080 -o",
    "dev:examples": "tsx scripts/dev-server.jsx"
  },
  "keywords": [
    "jsx",
    "ssr",
    "server-side-rendering",
    "infrastructure",
    "web-standards",
    "zero-overhead",
    "html-generation",
    "lume"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.19.0",
    "express": "^4.18.0",
    "tsx": "^4.20.6",
    "vite": "^5.0.0"
  }
}
